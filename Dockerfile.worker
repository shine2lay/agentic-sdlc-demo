FROM python:3.12-slim

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl git openssh-client \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /root/.ssh \
    && ssh-keyscan github.com >> /root/.ssh/known_hosts 2>/dev/null

# Copy temper-ai source and install (from additional build context)
COPY --from=temper pyproject.toml README.md /build/temper-ai/
COPY --from=temper temper_ai/ /build/temper-ai/temper_ai/
RUN pip install --no-cache-dir '/build/temper-ai[dashboard,llm-providers]' psutil && \
    rm -rf /build

# Copy workflow configs
COPY --from=temper configs/ /app/configs/

# Copy poller and entrypoint
COPY scripts/worker.py /app/worker.py
COPY scripts/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

ENTRYPOINT ["/app/entrypoint.sh"]
